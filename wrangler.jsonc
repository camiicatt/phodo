// Cloudflare: serve the static website in /site at phodo.app.
// No build step. /privacy → site/privacy.html, /terms → site/terms.html.
{
  "name": "phodo",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
